{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jeffreyyang3.github.io/schema/resume.schema.json",
  "title": "Jeffrey Yang resume",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metadata",
    "contact",
    "summary",
    "experience",
    "education",
    "download"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "email", "phone", "profiles"],
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\d{3}-\\d{3}-\\d{4}$"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "display", "url"],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "display": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "company",
          "title",
          "location",
          "startDate",
          "endDate",
          "highlights"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "company": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "startDate": {
            "type": "string",
            "format": "year-month"
          },
          "endDate": {
            "oneOf": [
              {
                "type": "string",
                "format": "year-month"
              },
              {
                "type": "null"
              }
            ]
          },
          "promotedAt": {
            "type": "string",
            "format": "year-month"
          },
          "highlights": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "institution",
          "degree",
          "graduationYear",
          "location"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "institution": {
            "type": "string",
            "minLength": 1
          },
          "degree": {
            "type": "string",
            "minLength": 1
          },
          "graduationYear": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "location": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "path", "mimeType"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.pdf$"
        },
        "mimeType": {
          "const": "application/pdf"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
